# Jimmy Chat Bot — environment variables
# Copy to .env.local (local dev) or set in your hosting dashboard.

# --- Telegram (required) ---
# Bot token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use admin features
TELEGRAM_ADMIN_USER_IDS=

# --- AI provider (at least one required) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Webhook (required in production) ---
# Public HTTPS base URL, e.g. https://your-app.onrender.com
WEBHOOK_BASE_URL=
# Shared secret for validating Telegram webhook calls (any random string)
TELEGRAM_WEBHOOK_SECRET=

# Optional Render automation
# Deploy Hook URL from Render Dashboard (enables approved deploy command)
RENDER_DEPLOY_HOOK_URL=
# Admin page URL used by the Telegram "เปิดหลังบ้าน" button; defaults to WEBHOOK_BASE_URL
ADMIN_PANEL_URL=

# --- Optional ---
# Path where bot config/state is persisted
STATE_FILE=./runtime-data/jimmy-bot-config.json
# Server port (default 3000)
PORT=3000
